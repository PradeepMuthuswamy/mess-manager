# Supabase — local dev: run `npm run db:start` then `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (auth email links, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — rate limiting (no-ops when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — transactional email (Resend sandbox works without custom domain)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Officers' Mess <onboarding@resend.dev>"

# Optional — admin app URL for cross-app invite/reset links
# NEXT_PUBLIC_OPS_APP_URL=http://localhost:3001
